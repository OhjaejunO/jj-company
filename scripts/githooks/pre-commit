#!/bin/sh
# JJ Company OS - primary worktree commit guard (charter section 3)
#
# ASCII-only on purpose: hook output goes through whatever client invoked git
# (Git Bash, PowerShell, an IDE). Korean here can arrive mangled in exactly the
# moment the message matters. The reasoning lives in CLAUDE.md section 3.
#
# WHY
#   HEAD is a shared resource. On 2026-08-15 a parallel session moved HEAD off
#   the branch another session was on, and that session's commit landed on the
#   wrong branch. Nothing errored. It was found by reading the reflog afterwards.
#
#   So the primary working tree is pinned to main and never receives commits.
#   All work happens in linked worktrees, where HEAD is private to that worktree.
#
# WHAT IT DOES
#   Refuses any commit made from the PRIMARY worktree. Linked worktrees pass.
#   Detection: `git rev-parse --git-dir` returns a path under .git/worktrees/
#   for a linked worktree, and plain `.git` for the primary one.
#
# INSTALL (per clone, once)
#   git config core.hooksPath scripts/githooks
#   Verify with: powershell -File scripts\check-repo-guard.ps1

git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0

case "$git_dir" in
    */worktrees/*)
        # Linked worktree: commits are allowed here. Before letting one through,
        # run the checkers that guard DATA invariants in this repo.
        #
        # WHY (2026-08-27): content-ops scenes.self_test() existed, passed nobody,
        # and a keyword shadow sat undetected for ten days because the only way to
        # run it was to type it. A check that has no automatic caller is not a
        # check - it is a note. These run in well under a second each.
        #
        # Scope: only when the file they guard is part of the commit. A commit that
        # touches docs must not pay for them.
        staged=$(git diff --cached --name-only 2>/dev/null)
        rc=0
        run_check() {
            # $1 = label, rest = command
            label=$1; shift
            if ! out=$("$@" 2>&1); then
                printf '\n  [repo-guard] %s FAILED - commit refused\n\n%s\n\n' "$label" "$out" >&2
                rc=1
            else
                printf '  [repo-guard] %s OK\n' "$label" >&2
            fi
        }
        case "$staged" in
            *departments/marketing/handoff_schema.py*)
                run_check "handoff_schema selftest" py departments/marketing/handoff_schema.py ;;
        esac
        case "$staged" in
            *scripts/consistency_audit.py*)
                run_check "consistency_audit selftest" py scripts/consistency_audit.py --selftest ;;
        esac
        case "$staged" in
            *departments/marketing/distcheck.py*)
                run_check "distcheck selftest" py departments/marketing/distcheck.py --selftest ;;
        esac
        case "$staged" in
            *.claude/hooks/bash-escape-guard.ps1*|*scripts/check-bash-guard.ps1*)
                run_check "bash-escape-guard reverse check" powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-bash-guard.ps1 ;;
        esac

        # --- canonical folders must not hold untracked files -----------------
        #
        # Backlog item 18. On 2026-08-29 the production directive was dropped into
        # docs/directives/ by hand and never committed. The file was there, so
        # everyone said "it is in the repo" - but untracked means NOT on
        # origin/main, NOT on the operations server, and one `git clean` from gone.
        #
        # WHY THIS LOOKS AT THE PRIMARY TREE, NOT HERE
        #   A person drops the file into the PRIMARY working tree. This hook runs
        #   in a LINKED worktree, which has its own checkout - an untracked file in
        #   the primary tree is simply not present here, so `git ls-files --others`
        #   run locally returns nothing. Measured 2026-08-29: the primary reported
        #   the stray file and the worktree reported an empty list for the same
        #   instant. A naive local check would pass forever while the problem sat
        #   one directory away. `--git-common-dir` gives the shared .git; its
        #   parent is the primary working tree, and that is where we look.
        #
        # Runs on EVERY commit, not only when docs are staged: the whole point is
        # to catch a file nobody staged. It is one `git ls-files` - microseconds.
        common=$(git rev-parse --git-common-dir 2>/dev/null)
        if [ -n "$common" ]; then
            primary=$(dirname "$common")
            for dir in docs/directives; do
                [ -d "$primary/$dir" ] || continue
                stray=$(git -C "$primary" ls-files --others --exclude-standard -- "$dir" 2>/dev/null)
                if [ -n "$stray" ]; then
                    printf '\n  [repo-guard] untracked file(s) in canonical folder %s - commit refused\n' "$dir" >&2
                    printf '\n%s\n' "$stray" >&2
                    printf '\n  A file called canonical is sitting outside the canonical store:\n' >&2
                    printf '  NOT on origin/main, NOT on the operations server, one `git clean`\n' >&2
                    printf '  from gone. Commit it (from a worktree) or move it out.\n\n' >&2
                    printf '      primary tree: %s\n\n' "$primary" >&2
                    rc=1
                fi
            done
        fi

        exit $rc
        ;;
esac

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')

cat >&2 <<EOF

  [repo-guard] commit refused: this is the PRIMARY worktree (branch: $branch)

  Charter section 3: the primary tree stays on main and takes no commits.
  Work in a linked worktree instead - HEAD there is private to that worktree,
  so a parallel session cannot move it out from under you.

      git worktree add ../.wt/<name> -b <branch> origin/main
      cd ../.wt/<name>
      ...work, commit, push, open PR...
      git worktree remove ../.wt/<name>
      git fetch origin

  ALREADY HAVE UNCOMMITTED WORK HERE? Move it, do not redo it. The stash is
  shared across worktrees, so this loses nothing:

      git stash push -u -m "move to worktree"
      git worktree add ../.wt/<name> -b <branch> origin/main
      cd ../.wt/<name>
      git stash pop

  CAUTION: gitignored files are NOT taken by "git stash -u". They stay behind
  in this tree, and the move looks complete because git status is clean. List
  them BEFORE you stash, and move them by hand afterwards:

      git status --porcelain --ignored | grep '^!!'

  Verify each copy (compare size and checksum) before deleting the original.
  Do not reach for "git stash -a" instead - that also drags logs/, reports/
  and .omc/ out of this tree.

  Reason this exists: 2026-08-15, twice. The second time happened while fixing
  the first. A commit silently landed on another session's branch.
  The stash caveat is from the same day: a 1.1MB codex session log was ignored
  by .gitignore, so "stash -u" left it behind while reporting success.

EOF

exit 1
