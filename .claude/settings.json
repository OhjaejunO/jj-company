{
  "permissions": {
    "deny": [
      "Edit(C:\\Obsidian.JJ\\JJ-Brain\\**)",
      "Edit(C:\\토망치\\**)",
      "Edit(C:\\Users\\ojaej\\OneDrive\\토망치_전달함\\**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(C:\\Users\\ojaej\\.aws\\**)",
      "Read(C:\\Users\\ojaej\\.config\\gcloud\\**)",
      "Read(C:\\Users\\ojaej\\.ssh\\**)"
    ],
    "allow": [
      "Bash(powershell -NoProfile -File scripts/publish-naver.ps1:*)",
      "Bash(powershell -NoProfile -File /c/Users/ojaej/jj-company/scripts/publish-naver.ps1:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bash-escape-guard.ps1\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gate_on_stop.py\"",
            "timeout": 300
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/context_watch.py\" prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/context_watch.py\" start",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
